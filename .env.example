# Copy to .env and fill in OPENROUTER_API_KEY. Everything else works as-is
# against the docker compose stack.
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed.

# ---- OpenRouter ----
# The only model gateway. Structured output is obtained via forced tool_choice,
# never response_format — see backend/app/agents/llm.py for why.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Scientific Skill Transfer Agent

# ---- Postgres ----
POSTGRES_USER=ssta
POSTGRES_PASSWORD=ssta_dev_password
POSTGRES_DB=ssta
DATABASE_URL=postgresql+asyncpg://ssta:ssta_dev_password@postgres:5432/ssta
# +psycopg selects psycopg 3, which is what this project pins. A bare
# postgresql:// URL resolves to psycopg2 and Alembic fails to import it.
SYNC_DATABASE_URL=postgresql+psycopg://ssta:ssta_dev_password@postgres:5432/ssta

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO / S3 ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ssta
S3_REGION=us-east-1
# Create the bucket during API startup. Set false when pointing at managed
# object storage where the bucket is provisioned out of band and the
# credentials have no CreateBucket permission.
S3_ENSURE_BUCKET_ON_STARTUP=true
# Hard cap on that startup check, so a slow or unreachable object store can
# never hold up the API's boot. boto3 is synchronous and retries with backoff.
S3_STARTUP_TIMEOUT_S=5.0

# ---- Sandbox ----
# The sandbox service deliberately receives NONE of the above secrets.
SANDBOX_URL=http://sandbox:8000
SANDBOX_TIMEOUT_S=600
SANDBOX_MEMORY_MB=3072

# ---- Agent ----
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.0
LOG_LEVEL=INFO

# ---- Published host ports ----
# Only change these if a port is already taken on your machine. Container
# ports never change, so nothing service-to-service is affected.
#
# On Windows, Hyper-V reserves scattered TCP ranges and 8000 often falls inside
# one, which surfaces as "bind: An attempt was made to access a socket in a way
# forbidden by its access permissions" even though nothing is listening. Check
# with:  netsh interface ipv4 show excludedportrange protocol=tcp
API_PORT=8000
FRONTEND_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
