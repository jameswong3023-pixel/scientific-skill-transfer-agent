# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# .env holds the live OPENROUTER_API_KEY. It must never be committed.
# .env.example (checked in) documents the required keys with placeholder values.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Assessment source material — not ours to redistribute
# ---------------------------------------------------------------------------
# The take-home brief belongs to the company issuing it, and the Ahmed et al.
# paper used by the example experiment is IEEE-copyrighted. Both are fetched or
# supplied at runtime; neither is committed.
Take-Home Project*.pdf
project description.jpg
# Review screenshots pasted into the working directory, not project files.
[0-9].png
data/papers/*.pdf
!data/papers/.gitkeep

# ---------------------------------------------------------------------------
# Internal planning documents
# ---------------------------------------------------------------------------
docs/superpowers/

